{
  "name": "mastermind",
  "version": "0.1.50",
  "description": "MASTERMIND — Cognitive Mapping OS",
  "main": "main.js",
  "author": "Mastermind",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir",
    "pack": "electron-builder --win --x64 --publish never",
    "postinstall": "electron-builder install-app-deps",
    "archive": "node scripts/archive-history.js",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.mastermind.app",
    "productName": "MASTERMIND",
    "copyright": "Copyright © 2025 Mastermind",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "extraResources": [
      {
        "from": "resources/whisper",
        "to": "whisper",
        "filter": [
          "**/*",
          "!README.md"
        ]
      },
      {
        "from": "resources/cloudflared",
        "to": "cloudflared",
        "filter": [
          "**/*",
          "!.gitkeep"
        ]
      }
    ],
    "files": [
      "modules/voice-lattice/ui-phone.js",
      "foundation/ai/phone-mic.js",
      "main.js",
      "preload.js",
      "index-browser.html",
      "MASTERMIND_DOCS.html",
      "nexus-engine.js",
      "nexus-canvas.js",
      "foundation/siso-jaa/mastermind-siso-jaa.js",
      "foundation/core/mastermind-foundation.js",
      "foundation/core/local-static-server.js",
      "foundation/ui/mm-dialogs.js",
      "foundation/vault/mastermind-vault.js",
      "foundation/vault/vault-envelope.js",
      "foundation/vault/vault-crypto.js",
      "foundation/vault/vault-mfa.js",
      "foundation/vault/vault-mfa-state.js",
      "foundation/vault/vault-guard.js",
      "foundation/vault/vault-ledger.js",
      "foundation/vault/atomic-write.js",
      "foundation/vault/vault-snapshots.js",
      "foundation/vault/vault-boot.js",
      "foundation/ai/assist-contract.js",
      "schemas/**/*",
      "modules/**/module.json",
      "foundation/ai/taxonomy.js",
      "foundation/ai/lexicon.js",
      "foundation/ai/capture-bridge.js",
      "foundation/ai/audio-import.js",
      "foundation/ai/voicing.js",
      "foundation/ai/clarity.js",
      "foundation/ai/clarity.js",
      "foundation/ai/voicing.js",
      "foundation/ai/pitch.js",
      "foundation/ai/whisper.js",
      "foundation/ai/transcribe-queue.js",
      "foundation/core/mm-session.js",
      "foundation/ui/mm-boot-screen.js",
      "foundation/ui/vendor/qrcode-generator.js",
      "foundation/ai/clearglass-transport.js",
      "foundation/ai/clearglass-config.js",
      "integrations/clearglass/mastermind-ai-bridge.user.js",
      "integrations/clearglass/README.md",
      "foundation/theme/mastermind-bg.js",
      "foundation/theme/mastermind-theme.css",
      "foundation/bus/warp-core.js",
      "foundation/bus/mastermind-warp-spine.js",
      "modules/leverage-map/engine.js",
      "modules/leverage-map/events.js",
      "modules/leverage-map/ui.js",
      "modules/alm/engine.js",
      "modules/alm/ui.js",
      "modules/alm/events.js",
      "modules/memory/engine.js",
      "modules/memory/ui.js",
      "modules/voice-lattice/audio-encode.js",
      "modules/voice-lattice/ui-capture.js",
      "modules/voice-lattice/engine.js",
      "modules/pattern-engine/engine.js",
      "modules/voice-lattice/recall.js",
      "modules/lattice/text-analysis.js",
      "modules/lattice/lattice.js",
      "modules/lattice/coherence.js",
      "modules/capture/capture.js",
      "modules/ai-status/status.js",
      "modules/voice-lattice/dictation.js",
      "foundation/bus/event-ledger.js",
      "foundation/ai/clearglass-main.js",
      "phasemap/**/*",
      "build/**/*",
      "docs/**/*",
      "scripts/**/*",
      "assets/salvage-v7/**/*",
      "assets/**/*",
      "!node_modules/**/*",
      "!dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "MASTERMIND-Setup-${version}.exe",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerHeader": "assets/installer/installer-header.bmp",
      "installerSidebar": "assets/installer/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer/installer-sidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MASTERMIND",
      "perMachine": false,
      "differentialPackage": false,
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "menuCategory": false,
      "runAfterFinish": true,
      "artifactName": "MASTERMIND-Setup-${version}.exe"
    }
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
