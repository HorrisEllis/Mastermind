{
  "name": "crystalball",
  "version": "1.0.0",
  "description": "CrystalBall — Associative Lattice Kernel with auto-update container",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev":   "electron . --dev",
    "pack":  "electron-builder --dir",
    "dist":  "electron-builder"
  },
  "dependencies": {
    "chokidar":   "^3.6.0",
    "simple-git": "^3.27.0",
    "ws":         "^8.18.0"
  },
  "devDependencies": {
    "electron":         "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId":       "io.crystalball.app",
    "productName": "CrystalBall",
    "files":       ["src/**/*", "modules/**/*", "assets/**/*"],
    "mac":  { "category": "public.app-category.productivity" },
    "win":  { "target": "nsis" },
    "linux":{ "target": "AppImage" }
  }
}
