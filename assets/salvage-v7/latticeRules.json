{
  "default": "SYS",
  "rules": [
    {
      "tag": "FRICTION",
      "pattern": "\\buh+h?\\b|\\bum+m?\\b|\\berr+\\b|\\bhm+\\b|\\bhmm+\\b"
    },
    {
      "tag": "BLOCK",
      "pattern": "\\bblocked?\\b|\\bstuck\\b|can't|cannot|\\bunable\\b"
    },
    {
      "tag": "LOOP",
      "pattern": "\\bagain\\b|\\bsame\\b|\\bevery time\\b|\\balways\\b|\\bkeep\\b"
    },
    {
      "tag": "GAP",
      "pattern": "\\bgap\\b|\\bmissing\\b|\\bunknown\\b|\\bdon't know\\b|unclear"
    },
    {
      "tag": "REL",
      "pattern": "\\bconnect(ed|s)?\\b|\\blink(ed|s)?\\b|\\brelat(e|es|ed)\\b"
    }
  ],
  "association": {
    "minWordLength": 4,
    "minSharedWords": 1,
    "bidirectional": true
  },
  "loopDetection": {
